{
    "name": "app/php-blog-test-assignment",
    "description": "A framework-free PHP blog created as a test assignment.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "db:migrate": "php bin/migrate.php",
        "db:seed": "php bin/seed.php",
        "test": "phpunit --configuration .config/phpunit.xml",
        "stan": "phpstan analyse --configuration=.config/phpstan.neon --no-progress",
        "cs-check": "php-cs-fixer fix --config=.config/php-cs-fixer.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=.config/php-cs-fixer.php",
        "composer-validate": "composer validate --strict",
        "security-audit": "composer audit",
        "quality": [
            "@composer-validate",
            "@cs-check",
            "@stan",
            "@test",
            "@security-audit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    }
}
